# Lingvo AI — Environment Variables

# Telegram
BOT_TOKEN=your_telegram_bot_token_from_botfather

# AI
GEMINI_API_KEY=your_gemini_api_key_from_ai_studio

# Database
DATABASE_PATH=/data/lingvo.db

# Server
PORT=8080
WEBAPP_URL=http://localhost:5173

# AI Fallback (OpenAI-compatible: OpenAI, DeepSeek, Groq, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Admins (comma-separated Telegram IDs)
ADMIN_IDS=123456789

# Development mode — all features unlocked, no rate limits
DEV_MODE=true
