{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", ".opencode/memory/context.md"],

  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@joshmossas/sqlite-mcp", "--dbPath", "/home/asdev/projects/sinking/lingvo.db"],
      "enabled": true,
      "env": {
        "SQLITE_DB_PATH": "/home/asdev/projects/sinking/lingvo.db"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/sequential-thinking-mcp"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true,
      "env": {
        "MEMORY_FILE_PATH": "/home/asdev/projects/sinking/.opencode/memory/memory.jsonl"
      }
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true
    }
  },

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": "allow",

  "experimental": {
    "primary_tools": [
      "edit", "read", "write", "glob", "grep", "bash",
      "task", "search", "list", "todowrite", "question",
      "skill"
    ],
    "mcp_timeout": 60000
  },

  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
