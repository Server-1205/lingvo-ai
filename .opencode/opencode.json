{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", ".opencode/memory/context.md"],

  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",

  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@joshmossas/sqlite-mcp", "--dbPath", "lingvo.db"],
      "enabled": true,
      "env": {
        "SQLITE_DB_PATH": "lingvo.db"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@stdlib/sequential-thinking-mcp"],
      "enabled": true
    }
  },

  "skills": {
    "paths": [".opencode/skills"]
  },

  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "go *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "*": "ask"
    },
    "external_directory": {
      "/home/asdev/projects/sinking/**": "allow",
      "*": "ask"
    }
  },

  "experimental": {
    "primary_tools": [
      "edit", "read", "write", "glob", "grep", "bash",
      "task", "search", "list", "todowrite", "question",
      "skill"
    ],
    "mcp_timeout": 60000
  },

  "compaction": {
    "auto": true,
    "tail_turns": 20
  }
}
